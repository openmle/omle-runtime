# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.pyd
*.exp

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

/build
# scikit-build-core's persistent CMake tree (tool.scikit-build build-dir).
# Kept across wheel builds so protobuf and Abseil compile once per platform
# rather than once per interpreter; ~180 MB of build output.
/python/build
/protobuf
/registries
/**/*.pyc

/.idea
/.vscode
/.cache
/java/target
# Generated by flatten-maven-plugin: the pom with ${revision} resolved.
/java/.flattened-pom.xml
# Staged by the release workflow: the per-platform native libraries are copied
# here so Maven packages them into the jar at <jna-prefix>/<libname>. Build
# output, never committed.
/java/src/main/resources
/spark/.bsp
/spark/target
/spark/project/target
# sbt metabuild output, created when project/plugins.sbt is compiled.
/spark/project/project
/spark/python/build
/out
*.egg-info/
/**/.DS_Store
/build_*
/build-*
/benchmark/models
/benchmark/results

**/catboost_info
/spark/python/omle_spark/_version.py
